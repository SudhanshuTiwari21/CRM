# Vercel production environment variables
# Copy each row into: Vercel → Project → Settings → Environment Variables → Production
# Then: Deployments → Redeploy (required after any env change)

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Skip login for client demos (set both to true)
DISABLE_AUTH=true
NEXT_PUBLIC_DISABLE_AUTH=true

# Required when DISABLE_AUTH is false
AUTH_SECRET=run: openssl rand -base64 32

AUTH_URL=https://crm-gray-three-95.vercel.app
NEXTAUTH_URL=https://crm-gray-three-95.vercel.app
AUTH_TRUST_HOST=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Book to Roam <your-email@gmail.com>

WEBHOOK_API_KEY=run: openssl rand -hex 32
NEXT_PUBLIC_APP_NAME=Book to Roam

# WhatsApp Cloud API (Meta Business)
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# After deploy, verify: https://crm-gray-three-95.vercel.app/api/health
# Login: admin@techrecoil.in / admin123 (after npm run db:seed on Neon)
