# Database
DATABASE_URL="postgresql://flightcrm:flightcrm_secret@localhost:5432/flight_booking_crm?schema=public"

# Set to true to skip login (demo only — do not use in production long-term)
DISABLE_AUTH="false"
NEXT_PUBLIC_DISABLE_AUTH="false"

# NextAuth — set AUTH_URL to your ngrok URL when sharing with clients (see npm run demo:sync)
AUTH_SECRET="generate-a-secure-random-string-here"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Gmail SMTP (App Password — NOT your regular Gmail password)
# 1. Enable 2-Step Verification on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password for "Mail"
# 4. Paste the 16-character password below (spaces are OK, they are stripped automatically)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
# IMPORTANT: From address must match SMTP_USER or a verified Gmail alias
SMTP_FROM="Book to Roam <your-email@gmail.com>"

# Webhook API Key (for future booking website)
WEBHOOK_API_KEY="your-secure-webhook-api-key"

# App
NEXT_PUBLIC_APP_NAME="Book to Roam"
