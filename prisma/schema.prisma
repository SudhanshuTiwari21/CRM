generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum BookingChannel {
  LIVE_API
  HELD
  OFFLINE
}

enum ProductType {
  FLIGHT
  HOTEL
  BUS
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PROCESSING
  CONFIRMED
  TICKET_SENT
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
  ON_CREDIT
}

enum CreditTransactionType {
  DEBIT
  CREDIT
  ADJUSTMENT
  REFUND
}

enum DocumentType {
  TICKET
  INVOICE
  VOUCHER
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum MealPlan {
  ROOM_ONLY
  WITH_BREAKFAST
  HALF_BOARD
  FULL_BOARD
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum InvoiceTaxType {
  ITC
  NON_ITC
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_CITY
  ADDON_SERVICES
}

enum AddonType {
  SEAT
  FOOD
  CUSTOM
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedBookings Booking[]    @relation("AssignedAgent")
  activityLogs     ActivityLog[]
  creditTransactions CustomerCreditTransaction[] @relation("CreditCreatedBy")
  accounts         Account[]
  sessions         Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Customer {
  id        String       @id @default(cuid())
  type      CustomerType @default(INDIVIDUAL)
  name      String
  email     String?
  phone     String
  pan       String?
  gstin     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  tags      String[]     @default([])
  creditEnabled    Boolean  @default(false)
  creditLimit      Decimal? @db.Decimal(12, 2)
  creditBalance    Decimal  @default(0) @db.Decimal(12, 2)
  paymentTermsDays Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  bookings Booking[]
  branches CustomerBranch[]
  contacts CustomerContact[]
  creditTransactions CustomerCreditTransaction[]

  @@index([phone])
  @@index([email])
  @@index([type])
}

model CustomerBranch {
  id         String   @id @default(cuid())
  customerId String
  name       String
  gstin      String?
  address    String?
  city       String?
  state      String?
  pincode    String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([gstin])
}

model CustomerContact {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  phone       String?
  email       String?
  designation String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerCreditTransaction {
  id           String                @id @default(cuid())
  customerId   String
  bookingId    String?
  type         CreditTransactionType
  amount       Decimal               @db.Decimal(12, 2)
  balanceAfter Decimal               @db.Decimal(12, 2)
  note         String?
  createdById  String?
  createdAt    DateTime              @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CreditCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([bookingId])
}

model BookingSerialCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model Booking {
  id              String         @id @default(cuid())
  publicRef       String         @unique
  serialYear      Int?
  serialNumber    Int?
  channel         BookingChannel
  productType     ProductType
  status          BookingStatus  @default(DRAFT)
  paymentStatus   PaymentStatus  @default(PENDING)
  totalAmount     Decimal        @db.Decimal(12, 2)
  currency        String         @default("INR")
  pnr             String?
  supplierRef     String?
  confirmedAt     DateTime?
  internalNotes   String?
  metadata        Json?
  customerId      String
  assignedAgentId String?
  lastEditedAt    DateTime?
  lastEditedById  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  assignedAgent User?          @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  flightBooking FlightBooking?
  hotelBooking  HotelBooking?
  busBooking    BusBooking?
  payments      Payment[]
  documents     Document[]
  emailLogs     EmailLog[]
  whatsappLogs  WhatsAppLog[]
  activityLogs  ActivityLog[]
  creditTransactions CustomerCreditTransaction[]

  @@unique([serialYear, serialNumber])
  @@index([status])
  @@index([channel])
  @@index([productType])
  @@index([pnr])
  @@index([createdAt])
}

model AirlineProfile {
  id        String   @id @default(cuid())
  name      String   @unique
  iataCode  String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model AgencyMsme {
  id        String   @id @default(cuid())
  label     String
  number    String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FlightBooking {
  id               String          @id @default(cuid())
  bookingId        String          @unique
  airline          String
  airlineLogoUrl   String?
  segments         Json
  passengers       Json
  tripType         TripType        @default(ONE_WAY)
  addonType        AddonType?
  addonCustomLabel String?
  addonCustomValue String?
  cabinClass       CabinClass      @default(ECONOMY)
  secondaryPnr     String?
  showEticket      Boolean         @default(false)
  showPassengerName Boolean        @default(true)
  checkInAssistance Boolean       @default(false)
  checkInAssistanceNotifiedAt DateTime?
  earliestDepartureAt DateTime?
  baseFare         Decimal?        @db.Decimal(12, 2)
  serviceCharge    Decimal?        @db.Decimal(12, 2)
  discountAmount   Decimal?        @db.Decimal(12, 2)
  invoiceTaxType     InvoiceTaxType  @default(NON_ITC)
  buyerGstin       String?
  buyerState       String?
  buyerStateCode   String?
  placeOfSupply    String?
  invoiceNarration String?
  msmeNumber       String?
  hsnSac           String          @default("998551")
  cgstRate         Decimal?        @db.Decimal(5, 2)
  sgstRate         Decimal?        @db.Decimal(5, 2)
  igstRate         Decimal?        @db.Decimal(5, 2)
  cgstAmount       Decimal?        @db.Decimal(12, 2)
  sgstAmount       Decimal?        @db.Decimal(12, 2)
  igstAmount       Decimal?        @db.Decimal(12, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model HotelProfile {
  id           String   @id @default(cuid())
  name         String   @unique
  address      String
  city         String?
  phone        String?
  email        String?
  checkInTime  String   @default("02:00 PM")
  checkOutTime String   @default("12:00 PM")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotelBookings HotelBooking[]

  @@index([name])
}

model HotelBooking {
  id                        String    @id @default(cuid())
  bookingId                 String    @unique
  hotelProfileId            String?
  propertyName              String
  propertyAddress           String
  city                      String?
  propertyPhone             String?
  propertyEmail             String?
  confirmationNo            String?
  checkIn                   DateTime
  checkOut                  DateTime
  checkInTime               String    @default("02:00 PM")
  checkOutTime              String    @default("12:00 PM")
  nights                    Int
  roomsCount                Int       @default(1)
  roomType                  String
  mealPlan                  MealPlan  @default(ROOM_ONLY)
  roomAmenities             String[]  @default([])
  guests                    Json
  inclusions                String?
  cancellationPolicy        String?
  includeCancellationPolicy Boolean   @default(false)
  policies                  String?
  agentRemarks              String?

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelProfile HotelProfile? @relation(fields: [hotelProfileId], references: [id], onDelete: SetNull)
}

model BusBooking {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  operator        String
  route           String
  boardingPoint   String
  droppingPoint   String
  departureAt     DateTime
  arrivalAt       DateTime
  seats           Json
  passengers      Json

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      String
  gatewayRef  String?
  status      PaymentStatus @default(PAID)
  paidAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Document {
  id          String       @id @default(cuid())
  bookingId   String
  type        DocumentType
  fileName    String
  storagePath String
  generatedAt DateTime     @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model EmailLog {
  id        String      @id @default(cuid())
  bookingId String?
  to        String
  subject   String
  template  String
  status    EmailStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
}

model WhatsAppLog {
  id        String      @id @default(cuid())
  bookingId String?
  to        String
  template  String
  body      String      @db.Text
  status    EmailStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  bookingId String?
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([createdAt])
}

model AgencySettings {
  id               String  @id @default("default")
  companyName      String  @default("Book to Roam")
  address          String?
  city             String?
  state            String?
  pincode          String?
  gstin            String?
  pan              String?
  tan              String?
  phone            String?
  email            String?
  logoUrl          String?
  invoicePrefix    String  @default("INV")
  bankName         String?
  bankAccount      String?
  bankIfsc         String?
  bankBranch       String?
  msmeRegistered   Boolean @default(false)
  msmeNumber       String?
  webhookApiKey    String?
  holdModeEnabled  Boolean @default(false)
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpFrom         String?
  whatsappEnabled       Boolean @default(false)
  whatsappPhoneNumberId String?
  whatsappApiVersion    String  @default("v21.0")
  updatedAt        DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}
