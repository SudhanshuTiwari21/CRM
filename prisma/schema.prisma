generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum CrmBrand {
  BOOK_TO_ROAM
  TECHRECOIL
}

enum BookingChannel {
  LIVE_API
  HELD
  OFFLINE
}

enum ProductType {
  FLIGHT
  HOTEL
  BUS
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PROCESSING
  CONFIRMED
  TICKET_SENT
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  FAILED
  ON_CREDIT
}

enum CreditTransactionType {
  DEBIT
  CREDIT
  ADJUSTMENT
  REFUND
}

enum DocumentType {
  TICKET
  INVOICE
  VOUCHER
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum MealPlan {
  ROOM_ONLY
  WITH_BREAKFAST
  HALF_BOARD
  FULL_BOARD
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum InvoiceTaxType {
  ITC
  NON_ITC
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_CITY
  ADDON_SERVICES
}

enum AddonType {
  SEAT
  FOOD
  CUSTOM
}

enum CancellationCategory {
  B2B
  B2C
}

enum BillingType {
  CASH
  LEDGER
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
}

enum FareType {
  NORMAL
  CORP
  FLEXI
  UPFRONT
}

enum CreditNoteSource {
  AUTO_CANCEL
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  PHONE
  WHATSAPP
  EMAIL
  WALK_IN
  REFERRAL
  WEBSITE
  OTHER
}

enum LeadNoteType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  STATUS_CHANGE
  ASSIGNMENT
}

enum LeadTemperature {
  HOT
  WARM
  COLD
  NONE
}

enum LeadServiceType {
  PACKAGE
  FLIGHT
  HOTEL
  VISA
  BUS
  OTHER
}

enum LeadCustomerSegment {
  B2C
  B2B
}

enum LeadTaskType {
  CALL
  TODO
}

enum LeadCallDirection {
  INCOMING
  OUTGOING
}

enum LeadCallOutcome {
  ANSWERED
  UNANSWERED
  NOT_REACHABLE
  CALLBACK
  LOST
}

enum TripPlanStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum TripServiceType {
  FLIGHT
  HOTEL
  TRANSFER
  SIGHTSEEING
  VISA
  MEAL
  GUIDE
  INSURANCE
  BUS
  OTHER
}

enum TripMarkupType {
  FIXED
  PERCENT
}

model User {
  id           String   @id @default(cuid())
  brandId      CrmBrand @default(BOOK_TO_ROAM)
  name         String
  email        String
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedBookings Booking[]    @relation("AssignedAgent")
  activityLogs     ActivityLog[]
  creditTransactions CustomerCreditTransaction[] @relation("CreditCreatedBy")
  cancellations    BookingCancellation[] @relation("CancelledBy")
  paymentsRecorded Payment[]             @relation("PaymentCreatedBy")
  creditNotes      CreditNote[]          @relation("CreditNoteCreatedBy")
  savedPassengers  SavedPassenger[]
  assignedLeads    Lead[]                @relation("LeadAssignedAgent")
  assignedOpsLeads Lead[]                @relation("LeadAssignedOps")
  createdLeads     Lead[]                @relation("LeadCreatedBy")
  leadNotes        LeadNote[]
  assignedLeadTasks LeadTask[]           @relation("LeadTaskAssignedTo")
  createdLeadTasks  LeadTask[]           @relation("LeadTaskCreatedBy")
  createdTripPlans  TripPlan[]           @relation("TripPlanCreatedBy")
  accounts         Account[]
  sessions         Session[]

  @@unique([brandId, email])
  @@index([brandId])
}

model SavedPassenger {
  id                   String   @id @default(cuid())
  title                String   @default("Mr")
  firstName            String
  lastName             String?
  gender               String   @default("Male")
  paxType              String   @default("adult")
  seat                 String?
  meal                 String?
  handBaggage          String?
  checkInBaggage       String?
  baggagePreset        String?
  cabinBaggagePreset   String?
  frequentFlyerAirline String?
  frequentFlyerNumber  String?
  wheelchairAssistance Boolean  @default(false)
  dateOfBirth          String?
  passportNumber       String?
  passportIssuingCountry String?
  passportIssueDate    String?
  passportExpiryDate   String?
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([firstName])
  @@index([lastName])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Customer {
  id        String       @id @default(cuid())
  brandId   CrmBrand     @default(BOOK_TO_ROAM)
  type      CustomerType @default(INDIVIDUAL)
  name      String
  email     String?
  phone     String
  pan       String?
  gstin     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  tags      String[]     @default([])
  creditEnabled    Boolean  @default(false)
  creditLimit      Decimal? @db.Decimal(12, 2)
  creditBalance    Decimal  @default(0) @db.Decimal(12, 2)
  paymentTermsDays Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  bookings Booking[]
  leads    Lead[]
  branches CustomerBranch[]
  contacts CustomerContact[]
  creditTransactions CustomerCreditTransaction[]
  creditNotes        CreditNote[]
  payments           Payment[]

  @@index([brandId])
  @@index([phone])
  @@index([email])
  @@index([type])
}

model CustomerBranch {
  id         String   @id @default(cuid())
  customerId String
  name       String
  gstin      String?
  address    String?
  city       String?
  state      String?
  pincode    String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([gstin])
}

model CustomerContact {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  phone       String?
  email       String?
  designation String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerCreditTransaction {
  id           String                @id @default(cuid())
  customerId   String
  bookingId    String?
  type         CreditTransactionType
  amount       Decimal               @db.Decimal(12, 2)
  balanceAfter Decimal               @db.Decimal(12, 2)
  note         String?
  createdById  String?
  createdAt    DateTime              @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CreditCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([bookingId])
}

model BookingSerialCounter {
  brandId    CrmBrand
  year       Int
  lastNumber Int      @default(0)

  @@id([brandId, year])
}

model CreditNoteSerialCounter {
  brandId    CrmBrand
  year       Int
  lastNumber Int      @default(0)

  @@id([brandId, year])
}

model CreditNote {
  id             String           @id @default(cuid())
  brandId        CrmBrand         @default(BOOK_TO_ROAM)
  publicRef      String
  serialYear     Int
  serialNumber   Int
  customerId     String
  bookingId      String?
  cancellationId String?          @unique
  amount         Decimal          @db.Decimal(12, 2)
  billingType    BillingType?
  reason         String?
  notes          String?
  source         CreditNoteSource @default(MANUAL)
  createdById    String?
  createdAt      DateTime         @default(now())

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking      Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  cancellation BookingCancellation? @relation(fields: [cancellationId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("CreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([brandId, publicRef])
  @@unique([brandId, serialYear, serialNumber])
  @@index([brandId])
  @@index([customerId])
  @@index([bookingId])
  @@index([createdAt])
}

model Booking {
  id              String         @id @default(cuid())
  brandId         CrmBrand       @default(BOOK_TO_ROAM)
  publicRef       String
  serialYear      Int?
  serialNumber    Int?
  channel         BookingChannel
  productType     ProductType
  billingType     BillingType    @default(LEDGER)
  status          BookingStatus  @default(DRAFT)
  paymentStatus   PaymentStatus  @default(PENDING)
  totalAmount     Decimal        @db.Decimal(12, 2)
  currency        String         @default("INR")
  pnr             String?
  supplierRef     String?
  confirmedAt     DateTime?
  internalNotes   String?
  metadata        Json?
  customerId      String
  assignedAgentId String?
  lastEditedAt    DateTime?
  lastEditedById  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  assignedAgent User?          @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  flightBooking FlightBooking?
  hotelBooking  HotelBooking?
  busBooking    BusBooking?
  payments      Payment[]
  documents     Document[]
  emailLogs     EmailLog[]
  whatsappLogs  WhatsAppLog[]
  activityLogs  ActivityLog[]
  creditTransactions CustomerCreditTransaction[]
  cancellation  BookingCancellation?
  creditNotes   CreditNote[]
  leads         Lead[]

  @@unique([brandId, publicRef])
  @@unique([brandId, serialYear, serialNumber])
  @@index([brandId])
  @@index([status])
  @@index([channel])
  @@index([productType])
  @@index([billingType])
  @@index([pnr])
  @@index([createdAt])
}

model LeadSerialCounter {
  brandId    CrmBrand
  year       Int
  lastNumber Int      @default(0)

  @@id([brandId, year])
}

model Lead {
  id              String               @id @default(cuid())
  brandId         CrmBrand             @default(BOOK_TO_ROAM)
  queryRef        String?
  serialYear      Int?
  serialNumber    Int?
  name            String
  phone           String?
  email           String?
  company         String?
  source          LeadSource           @default(OTHER)
  status          LeadStatus           @default(NEW)
  temperature     LeadTemperature      @default(NONE)
  serviceType     LeadServiceType?
  customerSegment LeadCustomerSegment  @default(B2C)
  productInterest ProductType?
  travelDate      DateTime?
  returnDate      DateTime?
  destinations    String?
  adultCount      Int?
  childCount      Int?
  infantCount     Int?
  estimatedValue  Decimal?             @db.Decimal(12, 2)
  currency        String               @default("INR")
  nextFollowUpAt  DateTime?
  lostReason      String?
  requirement     String?
  customerId      String?
  bookingId       String?
  assignedAgentId String?
  assignedOpsId   String?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  booking       Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  assignedAgent User?      @relation("LeadAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedOps   User?      @relation("LeadAssignedOps", fields: [assignedOpsId], references: [id], onDelete: SetNull)
  createdBy     User?      @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notes         LeadNote[]
  tasks         LeadTask[]
  tripPlans     TripPlan[]

  @@unique([brandId, queryRef])
  @@unique([brandId, serialYear, serialNumber])
  @@index([brandId])
  @@index([status])
  @@index([temperature])
  @@index([serviceType])
  @@index([source])
  @@index([assignedAgentId])
  @@index([assignedOpsId])
  @@index([phone])
  @@index([nextFollowUpAt])
  @@index([travelDate])
  @@index([createdAt])
  @@index([customerId])
}

model LeadNote {
  id        String       @id @default(cuid())
  leadId    String
  userId    String?
  type      LeadNoteType @default(NOTE)
  body      String
  details   Json?
  createdAt DateTime     @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([createdAt])
}

model LeadTask {
  id           String             @id @default(cuid())
  leadId       String
  type         LeadTaskType
  direction    LeadCallDirection?
  outcome      LeadCallOutcome?
  scheduledAt  DateTime?
  completedAt  DateTime?
  isCompleted  Boolean            @default(false)
  details      String?
  temperature  LeadTemperature?
  assignedToId String?
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("LeadTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User? @relation("LeadTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([scheduledAt])
  @@index([isCompleted])
  @@index([assignedToId])
}

model AirlineProfile {
  id        String   @id @default(cuid())
  name      String   @unique
  iataCode  String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model AgencyMsme {
  id        String   @id @default(cuid())
  label     String
  number    String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FlightBooking {
  id               String          @id @default(cuid())
  bookingId        String          @unique
  airline          String
  airlineLogoUrl   String?
  segments         Json
  passengers       Json
  tripType         TripType        @default(ONE_WAY)
  addonType        AddonType?
  addonCustomLabel String?
  addonCustomValue String?
  cabinClass       CabinClass      @default(ECONOMY)
  fareType         FareType        @default(NORMAL)
  paymentGatewayCharge Decimal?    @db.Decimal(12, 2)
  secondaryPnr     String?
  showEticket      Boolean         @default(false)
  showPassengerName Boolean        @default(true)
  checkInAssistance Boolean       @default(false)
  checkInAssistanceNotifiedAt DateTime?
  earliestDepartureAt DateTime?
  baseFare         Decimal?        @db.Decimal(12, 2)
  serviceCharge    Decimal?        @db.Decimal(12, 2)
  discountAmount   Decimal?        @db.Decimal(12, 2)
  invoiceTaxType     InvoiceTaxType  @default(NON_ITC)
  buyerGstin       String?
  buyerState       String?
  buyerStateCode   String?
  placeOfSupply    String?
  invoiceNarration String?
  msmeNumber       String?
  hsnSac           String          @default("998551")
  cgstRate         Decimal?        @db.Decimal(5, 2)
  sgstRate         Decimal?        @db.Decimal(5, 2)
  igstRate         Decimal?        @db.Decimal(5, 2)
  cgstAmount       Decimal?        @db.Decimal(12, 2)
  sgstAmount       Decimal?        @db.Decimal(12, 2)
  igstAmount       Decimal?        @db.Decimal(12, 2)
  cancellationPolicy        String?
  includeCancellationPolicy Boolean   @default(false)
  freqFlyerUpdatedToAirline Boolean   @default(false)
  specialAssistanceUpdatedToAirline Boolean @default(false)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model HotelProfile {
  id           String   @id @default(cuid())
  name         String   @unique
  address      String
  city         String?
  phone        String?
  email        String?
  checkInTime  String   @default("02:00 PM")
  checkOutTime String   @default("12:00 PM")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotelBookings HotelBooking[]

  @@index([name])
}

model HotelBooking {
  id                        String    @id @default(cuid())
  bookingId                 String    @unique
  hotelProfileId            String?
  propertyName              String
  propertyAddress           String
  city                      String?
  propertyPhone             String?
  propertyEmail             String?
  confirmationNo            String?
  checkIn                   DateTime
  checkOut                  DateTime
  checkInTime               String    @default("02:00 PM")
  checkOutTime              String    @default("12:00 PM")
  nights                    Int
  roomsCount                Int       @default(1)
  roomType                  String
  mealPlan                  MealPlan  @default(ROOM_ONLY)
  roomAmenities             String[]  @default([])
  adultsCount               Int       @default(1)
  childrenCount             Int       @default(0)
  guests                    Json
  inclusions                String?
  cancellationPolicy        String?
  includeCancellationPolicy Boolean   @default(false)
  policies                  String?
  agentRemarks              String?

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelProfile HotelProfile? @relation(fields: [hotelProfileId], references: [id], onDelete: SetNull)
}

model BusBooking {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  operator        String
  route           String
  boardingPoint   String
  droppingPoint   String
  departureAt     DateTime
  arrivalAt       DateTime
  seats           Json
  passengers      Json

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  brandId         CrmBrand      @default(BOOK_TO_ROAM)
  bookingId       String?
  customerId      String?
  amount          Decimal       @db.Decimal(12, 2)
  method          String
  gatewayRef      String?
  referenceNumber String?
  note            String?
  billingType     BillingType?
  status          PaymentStatus @default(PAID)
  paidAt          DateTime      @default(now())
  createdById     String?
  createdAt       DateTime      @default(now())

  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([brandId])
  @@index([bookingId])
  @@index([customerId])
  @@index([paidAt])
}

model Document {
  id          String       @id @default(cuid())
  bookingId   String
  type        DocumentType
  fileName    String
  storagePath String
  generatedAt DateTime     @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model EmailLog {
  id        String      @id @default(cuid())
  bookingId String?
  to        String
  subject   String
  template  String
  status    EmailStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
}

model WhatsAppLog {
  id        String      @id @default(cuid())
  bookingId String?
  to        String
  template  String
  body      String      @db.Text
  status    EmailStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  bookingId String?
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([createdAt])
}

model BookingCancellation {
  id               String               @id @default(cuid())
  bookingId        String               @unique
  category         CancellationCategory
  reason           String
  airlineRefund    Decimal?             @db.Decimal(12, 2)
  supplierCharges  Decimal?             @db.Decimal(12, 2)
  agencyCharges    Decimal?             @db.Decimal(12, 2)
  customerRefund   Decimal?             @db.Decimal(12, 2)
  cancellationFee  Decimal?             @db.Decimal(12, 2)
  supplierPenalty  Decimal?             @db.Decimal(12, 2)
  refundToCredit   Boolean              @default(false)
  notes            String?
  cancelledById    String?
  cancelledAt      DateTime             @default(now())
  createdAt        DateTime             @default(now())

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cancelledBy User?   @relation("CancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  creditNote  CreditNote?

  @@index([category])
  @@index([cancelledAt])
}

model AgencySettings {
  id               String   @id @default(cuid())
  brandId          CrmBrand @unique @default(BOOK_TO_ROAM)
  companyName      String   @default("Book to Roam")
  address          String?
  city             String?
  state            String?
  pincode          String?
  gstin            String?
  pan              String?
  tan              String?
  phone            String?
  email            String?
  logoUrl          String?
  invoicePrefix    String   @default("INV")
  bankName         String?
  bankAccount      String?
  bankIfsc         String?
  bankBranch       String?
  msmeRegistered   Boolean  @default(false)
  msmeNumber       String?
  webhookApiKey    String?
  holdModeEnabled  Boolean  @default(false)
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpFrom         String?
  whatsappEnabled       Boolean @default(false)
  whatsappPhoneNumberId String?
  whatsappApiVersion    String  @default("v21.0")
  updatedAt        DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(cuid())
  brandId   CrmBrand @default(BOOK_TO_ROAM)
  key       String
  subject   String
  body      String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([brandId, key])
  @@index([brandId])
}

model TripPlan {
  id             String         @id @default(cuid())
  brandId        CrmBrand       @default(BOOK_TO_ROAM)
  leadId         String
  version        Int            @default(1)
  title          String
  status         TripPlanStatus @default(DRAFT)
  travelDate     DateTime?
  returnDate     DateTime?
  destinations   String?
  adultCount     Int?
  childCount     Int?
  infantCount    Int?
  durationDays   Int?
  currency       String         @default("INR")
  subtotalCost   Decimal        @default(0) @db.Decimal(12, 2)
  subtotalSell   Decimal        @default(0) @db.Decimal(12, 2)
  offerPrice     Decimal        @default(0) @db.Decimal(12, 2)
  gstRate        Decimal?       @db.Decimal(5, 2)
  gstAmount      Decimal?       @db.Decimal(12, 2)
  inclusions     String?
  exclusions     String?
  terms          String?
  internalNotes  String?
  sentAt         DateTime?
  pdfGeneratedAt DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("TripPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     TripPlanItem[]

  @@unique([leadId, version])
  @@index([brandId])
  @@index([leadId])
  @@index([status])
}

model TripPlanItem {
  id           String          @id @default(cuid())
  tripPlanId   String
  dayNumber    Int             @default(1)
  sortOrder    Int             @default(0)
  serviceType  TripServiceType
  title        String
  description  String?
  supplierName String?
  location     String?
  serviceDate  DateTime?
  quantity     Int             @default(1)
  costPrice    Decimal         @default(0) @db.Decimal(12, 2)
  markupType   TripMarkupType  @default(FIXED)
  markupValue  Decimal         @default(0) @db.Decimal(12, 2)
  sellPrice    Decimal         @default(0) @db.Decimal(12, 2)
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tripPlan TripPlan @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)

  @@index([tripPlanId])
  @@index([dayNumber])
}
