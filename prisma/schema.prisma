generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum BookingChannel {
  LIVE_API
  HELD
  OFFLINE
}

enum ProductType {
  FLIGHT
  HOTEL
  BUS
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PROCESSING
  CONFIRMED
  TICKET_SENT
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum DocumentType {
  TICKET
  INVOICE
  VOUCHER
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedBookings Booking[]    @relation("AssignedAgent")
  activityLogs     ActivityLog[]
  accounts         Account[]
  sessions         Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  gstin     String?
  address   String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([phone])
  @@index([email])
}

model Booking {
  id              String         @id @default(cuid())
  publicRef       String         @unique
  channel         BookingChannel
  productType     ProductType
  status          BookingStatus  @default(DRAFT)
  paymentStatus   PaymentStatus  @default(PENDING)
  totalAmount     Decimal        @db.Decimal(12, 2)
  currency        String         @default("INR")
  pnr             String?
  supplierRef     String?
  confirmedAt     DateTime?
  internalNotes   String?
  metadata        Json?
  customerId      String
  assignedAgentId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  assignedAgent User?          @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  flightBooking FlightBooking?
  hotelBooking  HotelBooking?
  busBooking    BusBooking?
  payments      Payment[]
  documents     Document[]
  emailLogs     EmailLog[]
  activityLogs  ActivityLog[]

  @@index([status])
  @@index([channel])
  @@index([productType])
  @@index([pnr])
  @@index([createdAt])
}

model FlightBooking {
  id        String @id @default(cuid())
  bookingId String @unique
  airline   String
  segments  Json
  passengers Json

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model HotelBooking {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  propertyName   String
  propertyAddress String
  confirmationNo String?
  checkIn        DateTime
  checkOut       DateTime
  nights         Int
  roomType       String
  guests         Json
  policies       String?
  agentRemarks   String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BusBooking {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  operator        String
  route           String
  boardingPoint   String
  droppingPoint   String
  departureAt     DateTime
  arrivalAt       DateTime
  seats           Json
  passengers      Json

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      String
  gatewayRef  String?
  status      PaymentStatus @default(PAID)
  paidAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Document {
  id          String       @id @default(cuid())
  bookingId   String
  type        DocumentType
  fileName    String
  storagePath String
  generatedAt DateTime     @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model EmailLog {
  id        String      @id @default(cuid())
  bookingId String?
  to        String
  subject   String
  template  String
  status    EmailStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  bookingId String?
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([createdAt])
}

model AgencySettings {
  id               String  @id @default("default")
  companyName      String  @default("Book to Roam")
  address          String?
  city             String?
  state            String?
  pincode          String?
  gstin            String?
  phone            String?
  email            String?
  logoUrl          String?
  invoicePrefix    String  @default("INV")
  webhookApiKey    String?
  holdModeEnabled  Boolean @default(false)
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpFrom         String?
  updatedAt        DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}
